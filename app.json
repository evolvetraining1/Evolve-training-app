{
  "expo": {
    "name": "Evolve Training",
    "slug": "evolve-training-mvp",
    "scheme": "evolve",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-video",
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Evolve utilise tes photos uniquement pour estimer les aliments de ton repas.",
          "cameraPermission": "Evolve utilise la caméra pour analyser ton assiette."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Evolve utilise la caméra pour scanner les produits et analyser les repas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "android": {
      "package": "fr.evolvetraining.app",
      "versionCode": 2,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "351fbc52-60ff-48eb-920f-cc72354e2ccb"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/351fbc52-60ff-48eb-920f-cc72354e2ccb"
    },
    "ios": {
      "icon": "./assets/icon.png"
    },
    "icon": "./assets/icon.png"
  }
}
