import { router, useLocalSearchParams } from "expo-router";
import { useMemo, useState } from "react";
import {
  Image,
  KeyboardAvoidingView,
  Platform,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
} from "react-native";

import { colors } from "@/src/theme";

const PROGRAMS = {
  "tactical-reconditioning": {
    title: "TACTICAL RECONDITIONING",
    price: 300,
    description:
      "Reconditionnement physique complet orienté capacité de travail, force, endurance et retour à l'effort.",
    image: require("@/assets/tactical-reconditioning.png"),
  },

  "power-building": {
    title: "POWER BUILDING",
    price: 300,
    description:
      "Programme force et hypertrophie pour développer les performances sur les mouvements principaux tout en construisant du muscle.",
    image: null,
  },
} as const;

export default function ProgramCheckoutScreen() {
  const params = useLocalSearchParams<{
    programId?: string;
  }>();

  const program = useMemo(() => {
    const id = String(params.programId ?? "");

    if (id in PROGRAMS) {
      return PROGRAMS[id as keyof typeof PROGRAMS];
    }

    return null;
  }, [params.programId]);

  const [firstName, setFirstName] = useState("");
  const [lastName, setLastName] = useState("");
  const [email, setEmail] = useState("");
  const [phone, setPhone] = useState("");

  const [message, setMessage] = useState("");

  function continueToPayment() {
    if (
      !firstName.trim() ||
      !lastName.trim() ||
      !email.trim()
    ) {
      setMessage(
        "Renseigne au minimum ton prénom, ton nom et ton e-mail."
      );
      return;
    }

    if (!email.includes("@")) {
      setMessage("Entre une adresse e-mail valide.");
      return;
    }

    setMessage(
      "Paiement sécurisé : prochaine étape."
    );
  }

  if (!program) {
    return (
      <View style={styles.center}>
        <Text style={styles.error}>
          Programme introuvable.
        </Text>

        <Pressable
          style={styles.backButton}
          onPress={() => router.back()}
        >
          <Text style={styles.backText}>
            ← RETOUR
          </Text>
        </Pressable>
      </View>
    );
  }

  return (
    <KeyboardAvoidingView
      style={styles.screen}
      behavior={
        Platform.OS === "ios" ? "padding" : undefined
      }
    >
      <ScrollView
        contentContainerStyle={styles.page}
        keyboardShouldPersistTaps="handled"
        showsVerticalScrollIndicator={false}
      >
        <Pressable
          style={styles.backButton}
          onPress={() => router.back()}
        >
          <Text style={styles.backText}>
            ← RETOUR
          </Text>
        </Pressable>

        <Text style={styles.kicker}>
          EVOLVE TRAINING
        </Text>

        <Text style={styles.pageTitle}>
          Finaliser
        </Text>

        <Text style={styles.subtitle}>
          Vérifie ton programme et renseigne tes informations.
        </Text>

        <View style={styles.programCard}>
          {program.image ? (
            <Image
              source={program.image}
              style={styles.programImage}
              resizeMode="cover"
            />
          ) : (
            <View style={styles.placeholder}>
              <Text style={styles.placeholderSmall}>
                EVOLVE TRAINING
              </Text>

              <Text style={styles.placeholderTitle}>
                POWER BUILDING
              </Text>
            </View>
          )}

          <View style={styles.programContent}>
            <Text style={styles.programTitle}>
              {program.title}
            </Text>

            <Text style={styles.programDescription}>
              {program.description}
            </Text>

            <View style={styles.priceRow}>
              <Text style={styles.price}>
                {program.price} €
              </Text>

              <Text style={styles.paymentType}>
                PAIEMENT UNIQUE
              </Text>
            </View>
          </View>
        </View>

        <View style={styles.formCard}>
          <Text style={styles.sectionTitle}>
            TES INFORMATIONS
          </Text>

          <Text style={styles.label}>
            Prénom *
          </Text>

          <TextInput
            value={firstName}
            onChangeText={setFirstName}
            placeholder="Prénom"
            placeholderTextColor={colors.muted}
            style={styles.input}
          />

          <Text style={styles.label}>
            Nom *
          </Text>

          <TextInput
            value={lastName}
            onChangeText={setLastName}
            placeholder="Nom"
            placeholderTextColor={colors.muted}
            style={styles.input}
          />

          <Text style={styles.label}>
            E-mail *
          </Text>

          <TextInput
            value={email}
            onChangeText={setEmail}
            placeholder="ton@email.fr"
            placeholderTextColor={colors.muted}
            keyboardType="email-address"
            autoCapitalize="none"
            style={styles.input}
          />

          <Text style={styles.label}>
            Téléphone
          </Text>

          <TextInput
            value={phone}
            onChangeText={setPhone}
            placeholder="06..."
            placeholderTextColor={colors.muted}
            keyboardType="phone-pad"
            style={styles.input}
          />
        </View>

        <View style={styles.paymentCard}>
          <Text style={styles.sectionTitle}>
            PAIEMENT
          </Text>

          <View style={styles.totalRow}>
            <Text style={styles.totalLabel}>
              Total
            </Text>

            <Text style={styles.totalPrice}>
              {program.price} €
            </Text>
          </View>

          <Text style={styles.secureText}>
            Les informations bancaires seront saisies
            uniquement sur la page sécurisée du prestataire
            de paiement.
          </Text>

          <Pressable
            onPress={continueToPayment}
            style={({ pressed }) => [
              styles.payButton,
              pressed && { opacity: 0.82 },
            ]}
          >
            <Text style={styles.payButtonText}>
              CONTINUER VERS LE PAIEMENT
            </Text>
          </Pressable>

          {!!message && (
            <Text style={styles.message}>
              {message}
            </Text>
          )}
        </View>
      </ScrollView>
    </KeyboardAvoidingView>
  );
}

